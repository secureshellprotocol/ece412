mod pitch_detector;

use cpal::traits::{DeviceTrait, HostTrait, StreamTrait};
use ringbuf::{HeapRb, Producer, Consumer};
use pitch_detector::PitchDetector;
use std::thread;
use std::time::Duration;

fn main() -> Result<(), Box<dyn std::error::Error>> {
    let host = cpal::default_host();

    let device = host
        .default_input_device()
        .expect("No input device available");
    //println!("Using device: {}", device.name()?);

    let config = device.default_input_config()?;
    println!("Input config: {:?}", config);

    // Set up a Ring Buffer for thread-safe communication
    // We use a Heap-based Ring Buffer. 
    // Size is 4096 samples; in production, choose a size based on your latency needs.
    let rb = HeapRb::<f32>::new(4096);
    let (mut producer, mut consumer) = rb.split();

    let mut pyin_detector = PitchDetector::new(
        44100.0, 
        2048, // Window Size
        512   // Hop Size
    );

    // 5. Build the Input Stream
    // We use f32 as the sample format, which is standard for DSP.
    let input_stream = device.build_input_stream(
        config.into(),
        move |data: &[f32], _: &cpal::InputCallbackInfo| {
            // --- THE REAL-TIME AUDIO THREAD ---
            // DO NOT: println!, allocate memory, or use Mutexes here.
            // DO: Push samples into the ring buffer.
            for &sample in data {
                let _ = producer.push(sample);
            }
        },
        |err| eprintln!("An error occurred on stream: {}", err),
        None,
    )?;

    // Start the stream
    input_stream.play()?;
    println!("Audio stream started. Listening...");

    // 6. The "Processing Thread" (Main Thread)
    // This is where you will eventually implement your PSOLA/Filtering logic.
    loop {
                // 1. Pull samples from the hardware ring buffer
        let mut new_samples = Vec::new();
        while let Some(sample) = consumer.pop() {
            new_samples.push(sample);
        }

        if !new_samples.is_empty() {
            // 2. Feed the samples into the Pitch Detector
            detector.feed_samples(&new_samples);

            // 3. Trigger the mathematical update
            if detector.update() {
                // 4. Read the result
                if let Some(pitch) = detector.get_pitch() {
                    print!("\rCurrent Pitch: {:.2} Hz      ", pitch);
                    use std::io::{self, Write};
                    io::stdout().flush().unwrap();
                }
            }
        }

        thread::sleep(Duration::from_millis(5));
    }
}
